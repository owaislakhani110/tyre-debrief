# Copy to .env and fill in at least one key. Providers are tried in this order.
# *_MODEL accepts a comma-separated chain: an overloaded or retired model falls through to the next.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest

# OpenRouter (free models), used if Gemini is missing or fails: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
